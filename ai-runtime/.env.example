# Copy to .env for local (non-Docker) runs. In docker-compose, these are set
# directly as service environment variables instead (see ../docker-compose.yml) —
# no value here is hardcoded in application code (Phase 1.5 Configuration Layer).

# Local | Development | Testing | Docker | Production | Cloud
ENVIRONMENT=Local

API_BASE_URL=http://localhost:5080
REDIS_URL=redis://localhost:6380

# How other processes reach this runtime's agents (used only to populate the
# Agent Registry manifest's `endpoint` field — informational until distributed
# execution, §E16, is implemented).
SELF_BASE_URL=http://localhost:8000

# Filesystem tool sandbox root + per-write size cap (bytes).
WORKSPACE_FILES_ROOT=./.data/workspace-files
FILESYSTEM_MAX_BYTES=1000000

# Multi-Model Router (§E7) — leave all unset to run entirely on the
# deterministic mock provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=

HEARTBEAT_INTERVAL_SECONDS=15.0
CONSUMER_GROUP=ai-runtime-agents
CONSUMER_NAME=ai-runtime-1

# Phase 2 auth: shared with the API's Internal:ServiceKey — authenticates this
# process's own service-to-service calls (its startup default-Workspace
# bootstrap), since it has no user session. Local-dev-only default; must be
# overridden together with the API's value in any real deployment.
INTERNAL_SERVICE_KEY=local-dev-only-secret-change-me-before-any-real-deployment-32chars

LOG_LEVEL=INFO
